# Root .htaccess for SPA fallback — place this in public_html/ on cPanel
# (file is named public_html.htaccess in repo; rename to .htaccess when deploying)

RewriteEngine On

# Let API and uploads pass through
RewriteRule ^api/      - [L]
RewriteRule ^uploads/  - [L]

# Let existing files/dirs pass through
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback: all other requests → index.html
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Never cache index.html
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Long-cache hashed assets
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
